{
  "name": "pf2e-remaster",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "homepage": "https://gacoelho.github.io/pathfinder2E_app",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --clear",
    "predeploy": "npm run build:web",
    "deploy": "gh-pages -d dist",
    "serve": "npx serve dist",
    "analyze": "npx expo export --platform web --dump-assetmap",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~53.0.20",
    "expo-router": "^5.1.4",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.15.1",
    "zustand": "^5.0.8",
    "react-dom": "19.0.0",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "gh-pages": "^6.3.0",
    "typescript": "~5.8.3",
    "serve": "^14.2.1",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5"
  },
  "private": true
}
